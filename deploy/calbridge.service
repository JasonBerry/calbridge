# calbridge systemd unit (PLAN.md §13). Install:
#   sudo useradd --system --home /var/lib/calbridge --shell /usr/sbin/nologin calbridge
#   sudo install -m 0755 bin/calbridge /usr/local/bin/calbridge
#   sudo install -d -m 0750 -o root -g calbridge /etc/calbridge
#   sudo install -m 0640 -o root -g calbridge deploy/config.example.yaml /etc/calbridge/config.yaml   # then edit
#   sudo install -m 0600 -o calbridge -g calbridge google-client.json /etc/calbridge/google-client.json
#   sudo install -m 0600 -o root -g root icloud-app-password /etc/calbridge/icloud-app-password
#   sudo install -m 0644 deploy/calbridge.service /etc/systemd/system/calbridge.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now calbridge
# See README.md "Running it" for the Google authorization step.
[Unit]
Description=calbridge: Google Calendar invitations -> iCloud Calendar, with RSVPs back
Documentation=file:///usr/local/share/doc/calbridge/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=calbridge
Group=calbridge
ExecStart=/usr/local/bin/calbridge serve --config /etc/calbridge/config.yaml
Restart=on-failure
RestartSec=30
# Exit code 3 = another instance holds the database lock: don't loop.
RestartPreventExitStatus=3

# State (database, Google token, backups) lives here; created and owned by systemd.
StateDirectory=calbridge
StateDirectoryMode=0700
UMask=0077

# The iCloud app-specific password is handed over as a systemd credential
# ($CREDENTIALS_DIRECTORY/icloud-app-password); the file can stay root-only.
LoadCredential=icloud-app-password:/etc/calbridge/icloud-app-password

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/calbridge
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
